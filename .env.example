# 智能视觉报告生成与多模态质检系统 — 环境变量
APP_NAME=智能视觉报告生成与多模态质检系统
APP_VERSION=1.0.0
DEBUG=false

# YOLO 检测
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONF=0.35
YOLO_IMGSZ=640

# LLM 默认配置（可在 Web 管理页随时修改）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# 服务端口
HOST=0.0.0.0
PORT=8000
